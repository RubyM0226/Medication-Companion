SUPABASE_URL = key
SUPABASE_KEY = key
FLASK_SECRET_KEY = key
# Backend: allowed Expo web addresses
FRONTEND_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Backend: false for local HTTP; true for production HTTPS
SESSION_COOKIE_SECURE=false

# Frontend: the Flask server address. For testing on a physical phone, replace the last value with your computer’s LAN IP:
EXPO_PUBLIC_API_URL=http://localhost:5000

#tells Supabase where to send the user after they click the confirmation link
AUTH_REDIRECT_URL=http://YOUR-MAC-IP:5000/auth/confirmed

#localhost & ip specific urls will change once app domain is secured